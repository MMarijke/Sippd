# ── Supabase ─────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=       # server / Edge Functions only — NEVER prefix with VITE_, it would ship to the client bundle
SUPABASE_DB_PASSWORD=            # only needed locally for `supabase link` / `db push`, not read by the app

# ── Paddle ───────────────────────────────────────────────────────────────
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=         # sandbox | production
VITE_PADDLE_MONTHLY_PRICE_ID=    # from Paddle dashboard → Catalog → Prices
VITE_PADDLE_ANNUAL_PRICE_ID=     # from Paddle dashboard → Catalog → Prices
PADDLE_API_ENVIRONMENT=          # server-side: sandbox | production
PADDLE_API_KEY=                  # server-side only — from Paddle dashboard → Developer Tools
PADDLE_WEBHOOK_SECRET=           # server-side only — paddle-webhook edge function, from Paddle dashboard → Notifications

# ── Sentry ───────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=your-sentry-dsn-here
SENTRY_AUTH_TOKEN=               # source map uploads at build time — CI/server only
SENTRY_DSN=                      # edge functions only (Deno) — set via `supabase secrets set`, not read from this file

# ── Upstash Redis (Phase 6, Edge Functions only) ────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
